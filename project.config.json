{
  "project": {
    "name": "HelpDesk AI",
    "type": "multi-tenant SaaS ticketing platform",
    "status": "portfolio-ready, production-hardening required"
  },
  "stack": {
    "frontend": {
      "framework": "Next.js 15 App Router",
      "language": "TypeScript",
      "styles": "Tailwind CSS 4",
      "i18n": "next-intl"
    },
    "backend": {
      "runtime": "Node.js 20 on Vercel Functions",
      "api": "Next.js Route Handlers and Server Actions"
    },
    "database": {
      "provider": "Supabase",
      "engine": "PostgreSQL",
      "schema": "public",
      "authorization": "RLS plus server authorization"
    },
    "infrastructure": {
      "hosting": "Vercel",
      "ci": "GitHub Actions"
    }
  },
  "commands": {
    "dev": "npm run dev",
    "build": "npm run build",
    "lint": "npm run lint",
    "typecheck": "npm run typecheck",
    "test": "npm test"
  },
  "architecture": {
    "pattern": "App Router with tested domain policies and PostgreSQL RLS",
    "sourceRoots": ["app", "components", "lib"],
    "testsRoot": "tests",
    "skillsRoot": ".agents/skills"
  },
  "quality": {
    "zeroWarningLint": true,
    "strictTypeScript": true,
    "requiredCommands": ["npm run check", "npm run build", "npm audit --audit-level=high"],
    "externalReleaseGates": ["two-tenant RLS integration", "authenticated E2E", "staging migration verification"]
  },
  "design": {
    "direction": "Swiss support operations control room",
    "skill": ".agents/skills/frontend-design/SKILL.md",
    "requirements": ["responsive", "keyboard accessible", "reduced motion", "no unverified claims"]
  },
  "guardrails": {
    "agentGuide": "AGENTS.md",
    "security": "SECURITY.md",
    "definitionOfDone": "AGENTS.md#definition-of-done"
  }
}
