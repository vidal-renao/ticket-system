# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Server-only Supabase credential
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI integrations
ANTHROPIC_API_KEY=replace-with-anthropic-key
OPENAI_API_KEY=replace-with-openai-key

# Email
RESEND_API_KEY=replace-with-resend-key
EMAIL_FROM=HelpDesk AI <support@example.com>
EMAIL_INGEST_SECRET=replace-with-at-least-32-random-characters

# Scheduled jobs and one-time setup
CRON_SECRET=replace-with-at-least-32-random-characters
SETUP_SECRET=replace-with-at-least-32-random-characters
SETUP_ADMIN_USER_ID=00000000-0000-4000-8000-000000000001
SETUP_ORGANIZATION_ID=00000000-0000-4000-8000-000000000002

# Optional diagnostics
DEBUG=false

# Destructive seed guard. Keep unset outside disposable environments.
# ALLOW_DESTRUCTIVE_SEED=I_UNDERSTAND
# SEED_ORG_ID=
# SEED_ADMIN_ID=
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_AGENT_HARDWARE_ID=
# SEED_AGENT_HARDWARE_EMAIL=
# SEED_AGENT_HARDWARE_PASSWORD=
# SEED_AGENT_SOFTWARE_ID=
# SEED_AGENT_SOFTWARE_EMAIL=
# SEED_AGENT_SOFTWARE_PASSWORD=
# SEED_CUSTOMER_ID=
# SEED_CUSTOMER_EMAIL=
# SEED_CUSTOMER_PASSWORD=
